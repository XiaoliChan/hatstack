{"status": "ok", "kind": "records", "records": [{"id": "ccc-20c3-skolelinux", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Skolelinux", "speakers": [], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-631-SkoleLinux", "source_url": "https://media.ccc.de/v/20C3-631-SkoleLinux"}, {"id": "ccc-20c3-spam-analyse-603", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "spam analyse (603)", "speakers": [], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-603-Spam_Analyse", "source_url": "https://media.ccc.de/v/20C3-603-Spam_Analyse"}, {"id": "ccc-20c3-trustbased-p2p-exchange-on-the-semantic-web-and-the-wymiwyg-", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Trustbased P2P exchange on the semantic web and the WYMIWYG KnoBot project - An agent for decentralised knowledge exchange", "speakers": [{"name": "Reto Bachmann-Gmuer", "company": null, "role": null}], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-598-Trust_based_P2P_WYMIWYG_KnoBot_project", "source_url": "https://media.ccc.de/v/20C3-598-Trust_based_P2P_WYMIWYG_KnoBot_project"}, {"id": "ccc-20c3-ein-rant-ber-den-missbrauch-von-java-http-und-xml", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Ein Rant über den Missbrauch von Java, HTTP und XML", "speakers": [{"name": "Andreas Krennmair", "company": null, "role": null}], "abstract": "Die heutige Softwareindustrie verlässt sich auf so entscheidende Technologien wie Java, HTTP und XML. Unglücklicherweise werden diese drei Technologien in jeder erdenklichen Art und Weise eingesetzt, nur nicht in der ursprünglich dafür vorgesehenen. Dieser Vortrag zeigt anhand von Originalzitaten und Beispielen aus der Praxis, wofuer Java, HTTP und XML gedacht waren, und wie sie in Wirklichkeit eingesetzt werden.", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-557-Ein_Rant_ueber_den_Missbrauch_von_Java_HTTP_und_XML", "source_url": "https://media.ccc.de/v/20C3-557-Ein_Rant_ueber_den_Missbrauch_von_Java_HTTP_und_XML"}, {"id": "ccc-20c3-berichte-von-den-big-brother-awards", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Berichte von den Big Brother Awards", "speakers": [{"name": "Christian Mock", "company": null, "role": null}, {"name": "Rena Tangens", "company": null, "role": null}, {"name": "Matthias Geiser", "company": null, "role": null}], "abstract": "Die BigBrotherAwards Deutschland wurden ins Leben gerufen, um die öffentliche Diskussion um Privatsphäre und Datenschutz zu fördern - sie sollen missbräuchlichen Umgang mit Technik und Informationen zeigen. Seit 1998 wird ein solcher Preis in England, 1999 in Östererich und seit dem Jahr 2000 auch in Deutschland an Firmen, Organisationen und Personen verliehen, die in besonderer Weise und nachhaltig die Privatsphäre von Menschen beeinträchtigen oder persönliche Daten Dritten zugänglich machen. Zurzeit wird der Preis in 14 Ländern weltweit verliehen.", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-591-Berichte_von_den_Big_Brother_Awards", "source_url": "https://media.ccc.de/v/20C3-591-Berichte_von_den_Big_Brother_Awards"}, {"id": "ccc-20c3-distributed-computing-637", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "distributed computing (637)", "speakers": [], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-637-Distributed_Computing", "source_url": "https://media.ccc.de/v/20C3-637-Distributed_Computing"}, {"id": "ccc-20c3-linux-das-tool-zum-erstellen-von-distros-550-rock", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "linux das tool zum erstellen von distros (550-rock)", "speakers": [], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-550-ROCK-Linux_Das_Tool_zum_Erstellen_von_Distros", "source_url": "https://media.ccc.de/v/20C3-550-ROCK-Linux_Das_Tool_zum_Erstellen_von_Distros"}, {"id": "ccc-20c3-free-wlans-for-the-masses", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Free WLANs for the masses", "speakers": [{"name": "Jan Michael Hess", "company": null, "role": null}], "abstract": "The presentation \"Free WLAN for the Masses\" talks about the vision of creating an open network of WiFi hotspots that provide alternative mobile Internet access.", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-576-Free_WLANs_for_the_masses", "source_url": "https://media.ccc.de/v/20C3-576-Free_WLANs_for_the_masses"}, {"id": "ccc-20c3-er-ffnung", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Eröffnung", "speakers": [{"name": "Tim Pritlove", "company": null, "role": null}, {"name": "Andy Müller-Maguhn", "company": null, "role": null}, {"name": "Frank Rosengart", "company": null, "role": null}, {"name": "Andreas Bogk", "company": null, "role": null}], "abstract": "Eröffnung des 20. Chaos Communication Congress und organisatorische Hinweise von Nerd zu Nerd. Im Anschluß: erste öffentliche Präsentation des Dokumentationsvideos des Chaos Communication Camps.", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-555-Eroeffnung", "source_url": "https://media.ccc.de/v/20C3-555-Eroeffnung"}, {"id": "ccc-20c3-trusted-or-treacherous-eine-erste-einsch-tzung-des-neuen-tcg", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Trusted or Treacherous? - Eine erste Einschätzung des neuen TCG1.2 Entwurfes.", "speakers": [{"name": "Rüdiger Weis", "company": null, "role": null}, {"name": "Andreas Bogk", "company": null, "role": null}], "abstract": "Mit der im November 2003 in Amsterdam veröffentlichten TCG 1.2 Spezifikation hat die Trusted Comupting Group erste Schritte in Richtung der Nutzerinteressen gemacht. Eine erste Analyse zeigte jedoch, dass für \"Normal-Anwender\" zentrale Probleme bestehen bleiben.", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-542-Trusted_or_Treacherous", "source_url": "https://media.ccc.de/v/20C3-542-Trusted_or_Treacherous"}, {"id": "ccc-20c3-noc-preview", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "NOC Preview", "speakers": [{"name": "cpunkt", "company": null, "role": null}], "abstract": "An introduction to the features and capabilities of the computer network at 20C3. We explain how to use IPsec, IPv6 and 802.11a and 802.11b wireless networks.", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-531-NOC_Preview", "source_url": "https://media.ccc.de/v/20C3-531-NOC_Preview"}, {"id": "ccc-20c3-wsis-an-overview-the-world-summit-on-the-information-society", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "WSIS - An Overview - The World Summit on the Information Society Revisited", "speakers": [{"name": "Markus Beckedahl", "company": null, "role": null}, {"name": "Rikke Frank Jørgensen", "company": null, "role": null}, {"name": "Ralf Bendrath", "company": null, "role": null}], "abstract": "Lessons learned and steps ahead for activists, lobbyists and protesters", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-537-WSIS_Overview", "source_url": "https://media.ccc.de/v/20C3-537-WSIS_Overview"}, {"id": "ccc-20c3-fnord-jahresr-ckschau", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Fnord-Jahresrückschau", "speakers": [], "abstract": "Was wäre die Zeit vor Sylvester ohne einen Jahresrückblick? Dieser Jahresrückblick wird chronologisch einige Meldungen aus teilweise eher obskuren und alternativen Quellen aufgreifen, um so für den sich nur über Heise und Tagesschau informierenden Geek mal live zu zeigen, was er so an Tagesgeschehen verpaßt hat. Die Veranstaltung ist nicht bloß als Vorlesung oder Alternativ-Tagesschau gedacht, sondern soll durchaus auch in eine Diskussion münden, wie man sich am besten von den gleichgeschalteten Medien emanzipieren kann.", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-633-Fnord_Jahresrueckschau", "source_url": "https://media.ccc.de/v/20C3-633-Fnord_Jahresrueckschau"}, {"id": "ccc-20c3-rfid-600", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "rfid (600)", "speakers": [], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-600-RFID", "source_url": "https://media.ccc.de/v/20C3-600-RFID"}, {"id": "ccc-20c3-an-on-and-the-future-of-anonymizers-589", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "an.on and the future of anonymizers (589)", "speakers": [{"name": "Oliver Berthold", "company": null, "role": null}, {"name": "nulli", "company": null, "role": null}], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-589-AN_ON_and_the_future_of_anonymizers", "source_url": "https://media.ccc.de/v/20C3-589-AN_ON_and_the_future_of_anonymizers"}, {"id": "ccc-20c3-the-quintessenz-biometrics-doqubase1-630", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "the quintessenz biometrics doqubase1 (630)", "speakers": [], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc