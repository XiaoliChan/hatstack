"}, {"id": "ccc-20c3-chaos-jahresr-ckblick-2003", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Chaos Jahresrückblick 2003", "speakers": [{"name": "Andy Müller-Maguhn", "company": null, "role": null}, {"name": "Lars Weiler", "company": null, "role": null}], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-581-Chaos-Rueckblick-2003", "source_url": "https://media.ccc.de/v/20C3-581-Chaos-Rueckblick-2003"}, {"id": "ccc-20c3-gute-antennen-selber-bauen-644", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Gute Antennen selber bauen (644)", "speakers": [], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-644-Gute-Antennen-selber-bauen", "source_url": "https://media.ccc.de/v/20C3-644-Gute-Antennen-selber-bauen"}, {"id": "ccc-20c3-software-patente-es-ist-noch-nicht-vorbei", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Software-Patente - Es ist noch nicht vorbei", "speakers": [{"name": "Edward Gerhold", "company": null, "role": null}], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-599-Softwarepatente", "source_url": "https://media.ccc.de/v/20C3-599-Softwarepatente"}, {"id": "ccc-20c3-fragen-an-eine-maschinenlesbare-regierung-informationsfreihe", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Fragen an eine maschinenlesbare Regierung - Informationsfreiheitsgesetz jetzt!", "speakers": [{"name": "Gerriet Hellwig", "company": null, "role": null}, {"name": "Jörg Tauss", "company": null, "role": null}], "abstract": "Der Weltgipfel zur Informationsgesellschaft in Genf zeigte etwa zwei Richtungen von Informationen: Das Wahre und als Chance zur bildungsgestützten Demokratie, Mitsprache \"aller\". Die Regierungswirklichkeit hinkt dem noch etwas nach, vor allem die deutsche. Sogar die Türkei hat inzwischen ein Informationsfreiheitsgesetz, in Deutschland haben bislang nur einige Bundesländer ein Informationsfreiheitsgesetz.", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-574-Fragen_an_eine_maschinenlesbare_Regierung", "source_url": "https://media.ccc.de/v/20C3-574-Fragen_an_eine_maschinenlesbare_Regierung"}, {"id": "ccc-20c3-neue-notrufnummern-fuer-die-informationsgesellschaft-624", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "neue notrufnummern fuer die informationsgesellschaft (624)", "speakers": [], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-624-Neue_Notrufnummern_fuer_die_Informationsgesellschaft", "source_url": "https://media.ccc.de/v/20C3-624-Neue_Notrufnummern_fuer_die_Informationsgesellschaft"}, {"id": "ccc-20c3-security-nightmares-iii-wor-ber-wir-n-chstes-jahr-lachen-wer", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Security Nightmares III - Worüber wir nächstes Jahr lachen werden", "speakers": [{"name": "Ron", "company": null, "role": null}, {"name": "Frank Rieger", "company": null, "role": null}], "abstract": "Moderated Audience Discussion on \"Security Nightmares 2004\": which Security-Problems will we stumble upon tomorrow? Which Attack-Methods should we be prepared to defend against? Which major Technology will get hacked next year? We?ll be looking back at last years predictions and then walk upon the thin ice of predicting the future.", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-609-Security_Nightmares_III", "source_url": "https://media.ccc.de/v/20C3-609-Security_Nightmares_III"}, {"id": "ccc-20c3-device-hacking-with-jtag-653", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "device hacking with jtag (653)", "speakers": [], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-653-Device_hacking_with_JTAG", "source_url": "https://media.ccc.de/v/20C3-653-Device_hacking_with_JTAG"}, {"id": "ccc-20c3-schummeln-in-oeffentlichen-projekten-588", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Schummeln in Oeffentlichen Projekten (588)", "speakers": [], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-588-Schummeln_in_oeffentlichen-Projekten", "source_url": "https://media.ccc.de/v/20C3-588-Schummeln_in_oeffentlichen-Projekten"}, {"id": "ccc-20c3-practical-win32-and-unicode-exploitation", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "Practical Win32 and UNICODE exploitation", "speakers": [{"name": "FX of Phenoelit", "company": null, "role": null}], "abstract": "The talk could also be called \"Lessons learned when the Cisco guys went to Windows land\", because there are a number of things quite different in Windows land compared to other environments. One of these things is the frequent use of wide characters and the annoying difficulties that arise from that, including return addresses of 0x00410041.", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-538-Practical_WIN32_and_Unicode_exploitation", "source_url": "https://media.ccc.de/v/20C3-538-Practical_WIN32_and_Unicode_exploitation"}, {"id": "ccc-20c3-weird-programming-593", "event": {"region": "eu", "year": 2003, "label": "20C3"}, "title": "weird programming (593)", "speakers": [], "abstract": "", "track": null, "files": {"slides": null, "whitepaper": null, "tool": null}, "video_url": "https://media.ccc.de/v/20C3-593-Weird_programming", "source_url": "https://media.ccc.de/v/20C3-593-Weird_programming"}], "meta": {"source": "api.media.ccc.de", 